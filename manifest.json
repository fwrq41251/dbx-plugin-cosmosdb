{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/v0.6.58/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "io.github.fwrq41251.cosmosdb",
  "name": "Cosmos DB NoSQL",
  "version": "0.13.0",
  "publisher": "fwrq41251",
  "source": "https://github.com/fwrq41251/dbx-plugin-cosmosdb",
  "homepage": "https://github.com/fwrq41251/dbx-plugin-cosmosdb",
  "description": "Query and edit Azure Cosmos DB for NoSQL documents.",
  "icon": "assets/plugin.svg",
  "engines": {
    "dbx": ">=0.6.58",
    "host_api": "^1.0"
  },
  "permissions": [],
  "entrypoints": {
    "backend": {
      "executable": "bin/dbx-plugin-dbx-plugin-cosmosdb"
    },
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    }
  },
  "contributions": [
    {
      "type": "connection-provider",
      "id": "io.github.fwrq41251.cosmosdb.connection",
      "label": "Azure Cosmos DB for NoSQL",
      "database_type": "cosmosdb-nosql",
      "icon": "assets/plugin.svg",
      "fields": [
        {
          "key": "display_name",
          "label": "连接名称",
          "type": "text",
          "binding": "name",
          "required": true,
          "default": "Cosmos DB"
        },
        {
          "key": "host",
          "label": "Account Endpoint",
          "type": "text",
          "binding": "host",
          "required": true,
          "placeholder": "https://account.documents.azure.com:443/"
        },
        {
          "key": "account_key",
          "label": "Account Key",
          "type": "password",
          "binding": "secret",
          "required": true
        },
        {
          "key": "database_id",
          "label": "数据库 ID（可选）",
          "type": "text",
          "binding": "config",
          "placeholder": "与容器 ID 一起填写，保存为容器连接"
        },
        {
          "key": "container_id",
          "label": "容器 ID（可选）",
          "type": "text",
          "binding": "config",
          "placeholder": "打开连接后直接进入此容器"
        },
        {
          "key": "read_only",
          "label": "只读（关闭后允许文档增删改）",
          "type": "boolean",
          "binding": "config",
          "default": true
        }
      ],
      "workbench": "io.github.fwrq41251.cosmosdb.main",
      "capabilities": [
        "test",
        "connect",
        "disconnect"
      ]
    },
    {
      "type": "workbench",
      "id": "io.github.fwrq41251.cosmosdb.main",
      "label": "Cosmos DB NoSQL"
    },
    {
      "type": "mcp",
      "id": "io.github.fwrq41251.cosmosdb.mcp",
      "description": "Read-only container metadata, explicit-partition queries, point reads and local partition cache.",
      "external_tools": true,
      "ai_tools": false
    }
  ]
}
