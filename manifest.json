{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/v0.6.59/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "io.github.fwrq41251.cosmosdb",
  "name": "Cosmos DB NoSQL",
  "version": "0.26.0",
  "publisher": "fwrq41251",
  "source": "https://github.com/fwrq41251/dbx-plugin-cosmosdb",
  "homepage": "https://github.com/fwrq41251/dbx-plugin-cosmosdb",
  "description": "Query and edit Azure Cosmos DB for NoSQL documents.",
  "icon": "assets/plugin.svg",
  "engines": {
    "dbx": ">=0.6.59",
    "host_api": "^1.0"
  },
  "permissions": [],
  "entrypoints": {
    "backend": {
      "executable": "bin/dbx-plugin-dbx-plugin-cosmosdb"
    },
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    }
  },
  "contributions": [
    {
      "type": "connection-provider",
      "id": "io.github.fwrq41251.cosmosdb.connection",
      "label": "Azure Cosmos DB for NoSQL",
      "database_type": "cosmosdb-nosql",
      "icon": "assets/plugin.svg",
      "fields": [
        {
          "key": "display_name",
          "label": "Connection name",
          "type": "text",
          "binding": "name",
          "required": true,
          "default": "Cosmos DB"
        },
        {
          "key": "host",
          "label": "Account Endpoint",
          "type": "text",
          "binding": "host",
          "required": true,
          "placeholder": "https://account.documents.azure.com:443/"
        },
        {
          "key": "account_key",
          "label": "Account Key",
          "type": "password",
          "binding": "secret",
          "required": true
        },
        {
          "key": "read_only",
          "label": "Read-only (disable to allow document writes)",
          "type": "boolean",
          "binding": "config",
          "default": true
        }
      ],
      "workbench": "io.github.fwrq41251.cosmosdb.main",
      "capabilities": [
        "test",
        "connect",
        "disconnect"
      ]
    },
    {
      "type": "workbench",
      "id": "io.github.fwrq41251.cosmosdb.main",
      "label": "Cosmos DB NoSQL"
    },
    {
      "type": "mcp",
      "id": "io.github.fwrq41251.cosmosdb.mcp",
      "description": "Read-only access to the plugin-managed selected container, queries, point reads and local keys.",
      "external_tools": true,
      "ai_tools": false,
      "tools": {
        "container_info": {
          "access": "read"
        },
        "query": {
          "access": "read"
        },
        "read_document": {
          "access": "read"
        },
        "cached_partition_keys": {
          "access": "read"
        }
      }
    }
  ],
  "localizations": {
    "en": {
      "description": "Query and edit Azure Cosmos DB for NoSQL documents.",
      "contributions": {
        "io.github.fwrq41251.cosmosdb.connection": {
          "fields": {
            "display_name": {
              "label": "Connection name"
            },
            "host": {
              "label": "Account Endpoint"
            },
            "account_key": {
              "label": "Account Key"
            },
            "read_only": {
              "label": "Read-only (disable to allow document writes)"
            }
          }
        }
      }
    },
    "zh-CN": {
      "description": "查询和编辑 Azure Cosmos DB for NoSQL 文档。",
      "contributions": {
        "io.github.fwrq41251.cosmosdb.connection": {
          "fields": {
            "display_name": {
              "label": "连接名称"
            },
            "host": {
              "label": "账号地址（Account Endpoint）"
            },
            "account_key": {
              "label": "账号密钥（Account Key）"
            },
            "read_only": {
              "label": "只读（关闭后允许文档增删改）"
            }
          }
        }
      }
    },
    "zh": {
      "description": "查询和编辑 Azure Cosmos DB for NoSQL 文档。",
      "contributions": {
        "io.github.fwrq41251.cosmosdb.connection": {
          "fields": {
            "display_name": {
              "label": "连接名称"
            },
            "host": {
              "label": "账号地址（Account Endpoint）"
            },
            "account_key": {
              "label": "账号密钥（Account Key）"
            },
            "read_only": {
              "label": "只读（关闭后允许文档增删改）"
            }
          }
        }
      }
    }
  }
}
